# ==========================================
# 🔐 CREDENCIALES (OBLIGATORIO)
# ==========================================
# Tu API Key personal de Google Gemini.
# El script bootstrap_env.py llenará esto automáticamente.
GEMINI_API_KEY=

# ==========================================
# ⚙️ CONFIGURACIÓN DEL SERVIDOR (Uvicorn)
# ==========================================
# IP: 0.0.0.0 para exponer a red local / Docker, 127.0.0.1 para solo local.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ==========================================
# 🧠 RAG & MODELOS (Opcional - Defaults)
# ==========================================
# Rutas de almacenamiento
# BASE_DIR=/path/to/project
# PROCESSED_DOCS_PATH=/path/to/processed/docs
CHROMA_DB_PATH=chroma_db

# Configuración de modelos
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-2.5-flash

# NVIDIA opcional
# NVIDIA_API_KEY=
# EMBEDDING_PROVIDER=nvidia
# EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# GENERATION_PROVIDER=nvidia
# GENERATION_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Ajustes de Caché y Recuperación
# CACHE_TTL_MINUTES=60
# TOP_K_RESULTS=3
