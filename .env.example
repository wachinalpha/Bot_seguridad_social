# ==========================================
# 🔐 CREDENCIALES (OBLIGATORIO)
# ==========================================
# Tu API Key personal de Google Gemini
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# API key de NVIDIA NIM, necesaria solo si usás provider nvidia
# Obtener en: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Token de GitHub necesario solo si el repo anses-corpus es privado
# Debe tener acceso Read al repo wachinalpha/anses-corpus
GITHUB_TOKEN=

# ==========================================
# ⚙️ CONFIGURACIÓN DEL SERVIDOR (Uvicorn)
# ==========================================
# IP: 0.0.0.0 para Docker/red local, 127.0.0.1 para solo local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ==========================================
# 📊 CONFIGURACIÓN DE DATOS
# ==========================================
# Paths (relativos para local, absolutos para Docker)
# En Docker, se aísla por versión: /app/data/chroma_db/${CORPUS_VERSION}
# El corpus publicado se guarda en data/corpora/<version>
CHROMA_DB_PATH=data/chroma_db
CORPUS_STORAGE_PATH=data/corpora

# ==========================================
# 🔄 VERSIONADO DE CORPUS
# ==========================================
# Versión del corpus para aislar colecciones en ChromaDB
# Cambiar esto crea una nueva colección independiente
# Ejemplo: v1, v2, anses_2024, etc.
CORPUS_VERSION=v1

# ==========================================
# 🧠 RAG & MODELOS (Opcional - Defaults)
# ==========================================
# Providers disponibles inicialmente: gemini, nvidia
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001

GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-2.5-flash

# Alternativa NVIDIA API:
# EMBEDDING_PROVIDER=nvidia
# EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# GENERATION_PROVIDER=nvidia
# GENERATION_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Alias legacy todavía soportado si no se define GENERATION_MODEL
# LLM_MODEL=gemini-2.5-flash

# Opcional para NVIDIA embeddings
# NVIDIA_EMBEDDING_TRUNCATE=NONE
# NVIDIA_EMBEDDING_DIMENSIONS=2048
# NVIDIA_EMBEDDING_QUERY_INPUT_TYPE=query
# NVIDIA_EMBEDDING_DOCUMENT_INPUT_TYPE=passage

# Opcional para generación
# GENERATION_TEMPERATURE=0.2
# GENERATION_MAX_TOKENS=2048

# Configuración de caché y recuperación
# CACHE_TTL_MINUTES=60
# TOP_K_RESULTS=3

# ==========================================
# 🌐 CORS (Opcional - Defaults)
# ==========================================
# Orígenes permitidos para CORS (separados por coma)
# API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
