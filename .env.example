# ==========================================
# 🔐 CREDENCIALES (OBLIGATORIO)
# ==========================================
# Tu API Key personal de Google Gemini
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Token de GitHub necesario solo si el repo anses-corpus es privado
# Debe tener acceso Read al repo wachinalpha/anses-corpus
GITHUB_TOKEN=

# ==========================================
# ⚙️ CONFIGURACIÓN DEL SERVIDOR (Uvicorn)
# ==========================================
# IP: 0.0.0.0 para Docker/red local, 127.0.0.1 para solo local
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ==========================================
# 📊 CONFIGURACIÓN DE DATOS
# ==========================================
# Paths (relativos para local, absolutos para Docker)
# En Docker, se aísla por versión: /app/data/chroma_db/${CORPUS_VERSION}
# El corpus publicado se guarda en data/corpora/<version>
CHROMA_DB_PATH=data/chroma_db
CORPUS_STORAGE_PATH=data/corpora

# ==========================================
# 🔄 VERSIONADO DE CORPUS
# ==========================================
# Versión del corpus para aislar colecciones en ChromaDB
# Cambiar esto crea una nueva colección independiente
# Ejemplo: v1, v2, anses_2024, etc.
CORPUS_VERSION=v1

# ==========================================
# 🧠 RAG & MODELOS (Opcional - Defaults)
# ==========================================
# Modelos de Gemini (descomentar para forzar versiones)
# EMBEDDING_MODEL=models/text-embedding-004
# LLM_MODEL=models/gemini-1.5-pro

# Configuración de caché y recuperación
# CACHE_TTL_MINUTES=60
# TOP_K_RESULTS=3

# ==========================================
# 🌐 CORS (Opcional - Defaults)
# ==========================================
# Orígenes permitidos para CORS (separados por coma)
# API_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
